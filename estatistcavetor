#include <iostream>
using namespace std;
int main (){

    int vetor[8];
    int somap=0;
    int maior,menor, mediaac=0,mediaab=0, i , pmaior, pmenor;
    float media=0, soma=0;

    for (i = 0; i < 8; i++){
        cin >> vetor[i];
    }
    maior = vetor[0];
    menor = vetor[0];
    pmaior = pmenor = 0;

    for (i=0; i < 8; i++){
        soma+=vetor[i];
    }
    media = soma/8;

    for ( i = 0; i < 8; i=i+2){
        somap +=vetor[i];
    }
    for ( i = 0; i < 8; i++){
        if (vetor[i] > maior){
            maior = vetor[i];
            pmaior=i;
        }
    }
    for ( i = 0; i < 8; i++){
        if (vetor[i] < menor){
            menor = vetor[i];
            pmenor=i;
        }
    }
    for (i =0; i <8; i++){
        if (vetor[i] > media){
            mediaac ++;
        }
        else if (vetor[i]< media)
        {
            mediaab++;
        }
    }
    
    cout << "Maior elemento " << maior<< endl;
    cout <<"Posição do maior " << pmaior<< endl;
    cout <<"Menor elemento "<< menor<< endl;
    cout <<"Posição do menor " << pmenor <<endl;
    cout <<"Média" << media << endl;
    cout <<"Elementos acima da média " << mediaac << endl;
    cout <<"Elementos abaixo da média " << mediaab << endl;
    cout <<"Soma das posições pares " << somap << endl;
return 0;
}